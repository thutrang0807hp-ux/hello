# Names only. Keep real values in environment settings or a private local file.
# server.py does not automatically load this file.
# openai (legacy default) or gemini
FREELANCE_AI_PROVIDER=openai
FREELANCE_AI_KEY=
# Blank selects gpt-4.1-mini for OpenAI or gemini-2.5-flash for Gemini.
FREELANCE_AI_MODEL=
# Legacy setting: automatic job scoring is disabled; use the AI assessment button.
FREELANCE_AI_AUTO_JOBS=
FREELANCE_SLACK_TOKEN=
FREELANCE_SLACK_CHANNEL=
FREELANCE_TELEGRAM_TOKEN=
FREELANCE_TELEGRAM_CHAT_ID=
FREELANCE_PASSWORD=
PORT=8000
FREELANCE_BIND=127.0.0.1
# Set to 1 only when accessed via HTTPS.
FREELANCE_COOKIE_SECURE=0
